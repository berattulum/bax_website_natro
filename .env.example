# Local / Vercel — Sanity + Resend (no Payload / Neon / R2 for CMS)

NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
ALLOW_INDEXING=false

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=replace-with-a-long-random-secret
REVALIDATION_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-different-long-random-secret

# Contact form (Resend — required for submissions)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=BaX Composites <noreply@baxcomposites.com>
CONTACT_NOTIFY_EMAIL=info@baxcomposites.com

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTS=localhost

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
