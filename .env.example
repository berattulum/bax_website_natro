# Local Docker and live environments use PostgreSQL.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://bax:replace-with-a-long-local-password@127.0.0.1:5432/bax

# Existing SQLite database retained as the import source.
SQLITE_DATABASE_URL=file:./bax.db
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
REVALIDATION_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-different-long-random-secret

# Secure contact form (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTS=localhost

# Distributed production rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production media storage (Cloudflare R2 / S3 compatible)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
