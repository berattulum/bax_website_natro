# Vercel + Neon + Cloudflare R2 (primary production path)
# Copy values into the Vercel project Environment Variables (Production + Preview).

# Neon serverless Postgres (required)
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/bax?sslmode=require

# Payload / Next
PAYLOAD_SECRET=replace-with-a-long-random-secret-at-least-32-chars
NEXT_PUBLIC_SITE_URL=https://www.baxcomposites.com
APP_URL=https://www.baxcomposites.com
REVALIDATION_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-different-long-random-secret

# Indexing gate (keep false until launch acceptance)
ALLOW_INDEXING=false

# Cloudflare Turnstile (contact form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTS=www.baxcomposites.com,baxcomposites.com

# Upstash Redis (shared rate limiting across serverless instances)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 / S3-compatible media (required on Vercel — local FS is ephemeral)
S3_BUCKET=bax-media
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: force Docker standalone output when building images locally
# DOCKER_BUILD=1
# OUTPUT_STANDALONE=1
