# Vercel Environment Variables — Production + Preview

NEXT_PUBLIC_SITE_URL=https://www.baxcomposites.com
APP_URL=https://www.baxcomposites.com
ALLOW_INDEXING=false

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
REVALIDATION_SECRET=
PREVIEW_SECRET=

# Resend (contact form — required)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=BaX Composites <noreply@baxcomposites.com>
CONTACT_NOTIFY_EMAIL=info@baxcomposites.com

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTS=www.baxcomposites.com,baxcomposites.com

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
