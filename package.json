{
  "name": "bax-composites-web",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:up": "docker compose --env-file .env.postgres -f compose.local.yml up -d --wait postgres",
    "db:down": "docker compose --env-file .env.postgres -f compose.local.yml down",
    "db:logs": "docker compose --env-file .env.postgres -f compose.local.yml logs -f postgres",
    "db:psql": "docker compose --env-file .env.postgres -f compose.local.yml exec postgres psql -U bax -d bax",
    "start": "payload migrate && next start",
    "start:production": "payload migrate && next start",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run scripts/seed.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/db-sqlite": "3.86.0",
    "@payloadcms/live-preview-react": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/translations": "3.86.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "next": "16.2.6",
    "payload": "3.86.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
