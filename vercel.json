{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "regions": ["fra1"],
  "functions": {
    "src/app/(studio)/studio/[[...tool]]/page.tsx": {
      "maxDuration": 60
    },
    "src/app/api/submit-form/route.ts": {
      "maxDuration": 30
    }
  }
}
